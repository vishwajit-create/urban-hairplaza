# Urban Hairplaza – Server Configuration
# Copy this file to .env and fill in your values

# ── SERVER ───────────────────────────────────────
PORT=7890

# ── ADMIN CREDENTIALS ────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=urban@hairplaza2025

# ── SESSION SECRET (change this in production!) ──
SESSION_SECRET=urban_hairplaza_secret_key_2025

# ── WHATSAPP NOTIFICATIONS (CallMeBot) ───────────
# 1. Send "I allow callmebot to send me messages" to +34 644 59 73 97 on WhatsApp
# 2. You'll receive your API key via WhatsApp
# 3. Fill in your phone (with country code, no +) and the API key below

WHATSAPP_PHONE=916202692426
WHATSAPP_APIKEY=

# ── BUSINESS WHATSAPP (for wa.me fallback links) ──
BUSINESS_WHATSAPP=916202692426

# ── Cashfree Payment Gateway ──────────────────────────────────────────────
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENVIRONMENT=sandbox

# ── REAL MOBILE SMS OTP ─────────────────────────────────────────────────────
# Option 1: Textbee SMS Gateway (turns any Android device or cloud into SMS gateway)
# 1. Sign up at https://textbee.dev and register your device in Textbee app
# 2. Copy your API Key & Device ID from dashboard
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=

# Option 2: Fast2SMS (India Quick OTP API - recommended & cheapest for India)
# 1. Sign up free at https://www.fast2sms.com
# 2. Go to Dev API -> Copy Authorization Key
FAST2SMS_API_KEY=

# Option 2: Twilio SMS (Global SMS)
# Sign up at https://www.twilio.com -> Console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── REAL EMAIL OTP ──────────────────────────────────────────────────────────
# Option 1: Resend (Recommended - 3,000 free emails/month, fastest setup)
# 1. Sign up free at https://resend.com
# 2. Go to API Keys -> Create API Key
RESEND_API_KEY=
RESEND_FROM=Urban Hairplaza <onboarding@resend.dev>

# Option 2: Gmail SMTP (Free using any personal or business Gmail account)
# 1. Go to Google Account -> Security -> Enable 2-Step Verification
# 2. Go to App Passwords (https://myaccount.google.com/apppasswords)
# 3. Create an app password named "Urban Hairplaza" (16 letters)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Option 3: Brevo / Sendinblue (300 free emails/day)
# Sign up at https://www.brevo.com -> SMTP & API
BREVO_API_KEY=

