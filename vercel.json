      "destination": "/owner/login.html"
    },
    {
      "source": "/owner/login.html",
      "destination": "/owner/login.html"
    },
    {
      "source": "/owner/register",
      "destination": "/register-salon.html"
    },
    {
      "source": "/owner/dashboard",
      "destination": "/owner/dashboard.html"
    },
    {
      "source": "/owner/dashboard.html",
      "destination": "/owner/dashboard.html"
    },
    {
