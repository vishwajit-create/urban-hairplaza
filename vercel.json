{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/salons",
      "destination": "/salons.html"
    },
    {
      "source": "/explore-salons",
      "destination": "/salons.html"
    },
    {
      "source": "/register-salon",
      "destination": "/register-salon.html"
    },
    {
      "source": "/owner",
      "destination": "/owner/index.html"
    },
    {
      "source": "/owner/",
      "destination": "/owner/index.html"
    },
    {
