{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/account",
      "destination": "/account.html"
    },
    {
      "source": "/login",
      "destination": "/account.html"
    },
    {
      "source": "/my-bookings",
      "destination": "/account.html"
    },
    {
      "source": "/pay",
      "destination": "/pay.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/privacy-policy",
      "destination": "/privacy.html"
    },
    {
      "source": "/cookies",
      "destination": "/privacy.html"
    },
    {
      "source": "/terms",
      "destination": "/privacy.html"
    },
    {
      "source": "/admin",
      "destination": "/admin/login.html"
    },
    {
      "source": "/admin/",
      "destination": "/admin/login.html"
    }
  ]
}
